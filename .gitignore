.env
*.pyc
dataset/SUNRGBD/*
dataset/SUNRGBD.zip
dataset/SUNRGBD.zip.aria2
further_scripts/OpenAI_Eval/openai_results/*
further_scripts/Panesar_Recreation/panesar_model_results/*
further_scripts/.DS_Store
.gitignore
.DS_Store

# Raw SUNRGBD toolbox download — not source, fetched separately (see docs).
dataset/SUNRGBDtoolbox.zip
dataset/SUNRGBDtoolbox/
dataset/__MACOSX/

# Raw ARKitScenes downloads — not source, fetched via download_data.py (see
# arkitscenes_plan.md). Phase 0's 5-scan sample alone is ~9,300 individual
# files (one per frame per asset type); a Phase 2 subset would be far larger.
dataset/ARKitScenes_phase0/
dataset/ARKitScenes/
# Apple's own ARKitScenes repo (download_data.py + metadata CSVs), cloned as
# a tool dependency, not vendored source — it carries its own nested .git,
# which is exactly why it needs its own explicit line rather than being
# swept in by a parent-directory pattern.
dataset/dataset_creation/arkit_tools/ARKitScenes/
# Ad-hoc progress log of the Phase 2 bulk download driver — not curated
# evidence like build_log/*.csv, just a growing run log.
dataset/dataset_creation/arkit_tools/phase2_download.log

# v2 pipeline intermediates — regenerable from data/config.yaml + the raw
# toolbox via build_index.py (P0) and the P2 generators. Not committed to
# keep repo size sane; data/vocab, data/splits, data/templates (curated
# decisions) and release/ (the frozen deliverable) are kept.
data/index/
data/candidates/
session/*
docs/NEW_SUBMISSION.md

# Model environments. `.venv` runs the test suite; `.venv-models` carries a
# current transformers for the Qwen3.5 portfolio (the pinned one cannot load it).
.venv
.venv/
.venv-models/

# Downloaded HF checkpoints (Qwen3.5-9B/0.8B, InternVL, SmolVLM2, Florence-2,
# Gemma teachers/students) and any trained adapters — weights do not belong in
# git; MAIN_ROOT_DATA_DIR (.env) points here.
checkpoints_scratch/

# Run artifacts: the recorded run directories under runs/<run_id>/ ARE committed
# — they are the paper's evidence. What is excluded is everything regenerable or
# large:
#   * loose staging CSVs written by the inference script, which record_run.py
#     copies into the run directory as predictions.csv (keeping both invites the
#     duplicate-file confusion documented in legacy_discrepancy_report.md);
#   * trained adapters and checkpoints — weights do not belong in git.
runs/pilot/*.csv
runs/*.csv
runs/**/adapter/
runs/**/*_train/
docs/Previous_rejection_comments.md

# Ad-hoc scratch/smoke-test run directories — not the timestamped
# runs/<run_id>/ evidence convention above, and too large to keep in git.
runs/kd/
runs/kd_smoke/
runs/b4/
runs/b4v2/
runs/_smoke/
runs/confirmatory/
runs/lr_search/
runs/gemma_noqat/
runs/gemma_qat/
runs/teacher_bf16/
runs/pilot/B3_depth_4090_profile/

# ARKitScenes Phase 5 ladder — exploratory/noisy single-seed results, not
# yet confirmatory evidence (arkitscenes_plan.md §6); the pipeline that
# produced them (run_phase5.sh) lives here too, kept local for now.
runs/kd_arkit/
