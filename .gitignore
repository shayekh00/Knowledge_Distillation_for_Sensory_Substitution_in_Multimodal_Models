.env
*.pyc
dataset/SUNRGBD/*
further_scripts/OpenAI_Eval/openai_results/*
further_scripts/Panesar_Recreation/panesar_model_results/*
further_scripts/.DS_Store
.gitignore
.DS_Store

# Raw SUNRGBD toolbox download — not source, fetched separately (see docs).
dataset/SUNRGBDtoolbox.zip
dataset/SUNRGBDtoolbox/
dataset/__MACOSX/

# v2 pipeline intermediates — regenerable from data/config.yaml + the raw
# toolbox via build_index.py (P0) and the P2 generators. Not committed to
# keep repo size sane; data/vocab, data/splits, data/templates (curated
# decisions) and release/ (the frozen deliverable) are kept.
data/index/
data/candidates/
session/*
docs/NEW_SUBMISSION.md

# Model environments. `.venv` runs the test suite; `.venv-models` carries a
# current transformers for the Qwen3.5 portfolio (the pinned one cannot load it).
.venv/
.venv-models/

# Run artifacts: the recorded run directories under runs/<run_id>/ ARE committed
# — they are the paper's evidence. What is excluded is everything regenerable or
# large:
#   * loose staging CSVs written by the inference script, which record_run.py
#     copies into the run directory as predictions.csv (keeping both invites the
#     duplicate-file confusion documented in legacy_discrepancy_report.md);
#   * trained adapters and checkpoints — weights do not belong in git.
runs/pilot/*.csv
runs/**/adapter/
runs/**/*_train/
